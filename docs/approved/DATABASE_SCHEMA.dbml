// Version 1 logical ERD — design only, not executable migrations.
// All IDs are UUID; timestamps UTC. No tenant_id: one isolated database per deployment.
// All FK delete behavior is RESTRICT unless an implementation migration explicitly proves safe draft cleanup.
// See DATABASE_ERD.md and specification for partial indexes, checks and transaction invariants.
Project retail_v1 {
  database_type: "PostgreSQL"
  Note: "Reusable master; tax disabled; immutable commerce histories."
}

Table user {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  email varchar(255) [not null]
  normalized_email varchar(255) [not null]
  password_hash text
  status varchar(255) [not null]
  email_verified_at timestamptz
  last_login_at timestamptz
  indexes {
    normalized_email [unique]
  }
  Note: "One shared identity model; no raw password/OTP/MFA secrets."
}

Table customer_profile {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  user_id uuid [not null]
  display_name varchar(255) [not null]
  phone varchar(255)
  locale varchar(255) [not null]
  reporting_identity_hash varchar(255) [not null]
  indexes {
    user_id [unique]
  }
}

Table staff_profile {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  user_id uuid [not null]
  display_name varchar(255) [not null]
  status varchar(255) [not null]
  mfa_required boolean [not null]
  indexes {
    user_id [unique]
  }
}

Table role {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null]
  name varchar(255) [not null]
  is_system boolean [not null]
  indexes {
    code [unique]
  }
}

Table permission {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null]
  description text [not null]
  indexes {
    code [unique]
  }
}

Table staff_role {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  staff_id uuid [not null]
  role_id uuid [not null]
  indexes {
    (staff_id, role_id) [unique]
  }
}

Table role_permission {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  role_id uuid [not null]
  permission_id uuid [not null]
  indexes {
    (role_id, permission_id) [unique]
  }
}

Table staff_invitation {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  email varchar(255) [not null]
  token_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  accepted_at timestamptz
  revoked_at timestamptz
  invited_by uuid [not null]
}

Table invitation_role {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  invitation_id uuid [not null]
  role_id uuid [not null]
  indexes {
    (invitation_id, role_id) [unique]
  }
}

Table external_identity {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  user_id uuid [not null]
  provider varchar(255) [not null]
  subject varchar(255) [not null]
  indexes {
    (provider, subject) [unique]
  }
}

Table auth_challenge {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  user_id uuid
  email_hash varchar(255) [not null]
  purpose varchar(255) [not null]
  token_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  used_at timestamptz
  attempt_count integer [not null]
  audience varchar(255) [not null]
}

Table auth_session {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  user_id uuid [not null]
  token_hash varchar(255) [not null]
  audience varchar(255) [not null]
  expires_at timestamptz [not null]
  last_seen_at timestamptz [not null]
  revoked_at timestamptz
  mfa_verified_at timestamptz
  indexes {
    token_hash [unique]
  }
  Note: "Logical session contract; may map to Django/session/MFA framework tables."
}

Table mfa_device {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  staff_id uuid [not null]
  encrypted_secret_ref varchar(255) [not null]
  confirmed_at timestamptz
  last_used_counter bigint
}

Table mfa_recovery_code {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  device_id uuid [not null]
  code_hash varchar(255) [not null]
  consumed_at timestamptz
}

Table guest_order_access {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  order_id uuid [not null]
  token_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  indexes {
    token_hash [unique]
  }
}

Table address {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  customer_id uuid [not null]
  label varchar(255) [not null]
  recipient varchar(255) [not null]
  phone varchar(255) [not null]
  country_code varchar(255) [not null]
  city varchar(255) [not null]
  area_id uuid
  line1 text [not null]
  line2 text
  postal_code varchar(255)
  is_default boolean [not null]
}

Table media_asset {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  storage_key varchar(255) [not null]
  purpose varchar(255) [not null]
  mime_type varchar(255) [not null]
  byte_size bigint [not null]
  checksum varchar(255) [not null]
  status varchar(255) [not null]
  uploaded_by uuid
  alt_translations jsonb [not null]
  indexes {
    storage_key [unique]
  }
  Note: "Private staging/import/invoice/export assets require authorization; public merchandising assets are separately classified."
}

Table brand {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null]
  status varchar(255) [not null]
  logo_asset_id uuid
  indexes {
    code [unique]
  }
}

Table category {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null]
  parent_id uuid
  status varchar(255) [not null]
  image_asset_id uuid
  indexes {
    code [unique]
  }
  Note: "Acyclic parent tree; category code is stable; subcategory is a category with parent."
}

Table product {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null]
  brand_id uuid
  kind varchar(255) [not null]
  status varchar(255) [not null]
  featured boolean [not null]
  new_arrival boolean [not null]
  bestseller_override boolean [not null]
  low_stock_threshold integer [not null]
  version bigint [not null]
  published_at timestamptz
  indexes {
    code [unique]
  }
  Note: "kind simple or variable. Cost/price/stock exist on sellable variants, not duplicated here."
}

Table product_category {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  product_id uuid [not null]
  category_id uuid [not null]
  is_primary boolean [not null]
  indexes {
    (product_id, category_id) [unique]
  }
  Note: "Partial unique index product_id WHERE is_primary; at least one primary before publish."
}

Table tag {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null]
  indexes {
    code [unique]
  }
}

Table product_tag {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  product_id uuid [not null]
  tag_id uuid [not null]
  indexes {
    (product_id, tag_id) [unique]
  }
}

Table product_relation {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  product_id uuid [not null]
  related_product_id uuid [not null]
  kind varchar(255) [not null]
  position integer [not null]
  indexes {
    (product_id, related_product_id, kind) [unique]
  }
  Note: "No self relation; kind related/cross_sell/upsell."
}

Table collection {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null]
  status varchar(255) [not null]
  indexes {
    code [unique]
  }
}

Table collection_product {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  collection_id uuid [not null]
  product_id uuid [not null]
  position integer [not null]
  indexes {
    (collection_id, product_id) [unique]
  }
}

Table product_image {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  product_id uuid [not null]
  asset_id uuid [not null]
  position integer [not null]
  is_primary boolean [not null]
  indexes {
    (product_id, asset_id) [unique]
  }
  Note: "At most one primary image per product via partial unique index."
}

Table catalog_publication {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  resource_kind varchar(255) [not null]
  resource_id uuid [not null]
  revision bigint [not null]
  snapshot jsonb [not null]
  published_at timestamptz [not null]
  is_current boolean [not null]
  indexes {
    (resource_kind, resource_id, revision) [unique]
  }
  Note: "Validated immutable public snapshot; partial unique resource kind/ID WHERE is_current. Product snapshot includes variant publication metadata, not mutable stock."
}

Table attribute_definition {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null]
  data_type varchar(255) [not null]
  unit varchar(255)
  filterable boolean [not null]
  searchable boolean [not null]
  comparable boolean [not null]
  variant_eligible boolean [not null]
  validation jsonb [not null]
  status varchar(255) [not null]
  indexes {
    code [unique]
  }
  Note: "data_type text/long_text/number/boolean/date/single_select/multi_select; type changes blocked when values exist."
}

Table attribute_option {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  attribute_id uuid [not null]
  code varchar(255) [not null]
  position integer [not null]
  status varchar(255) [not null]
  indexes {
    (attribute_id, code) [unique]
  }
}

Table attribute_set {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null]
  name varchar(255) [not null]
  indexes {
    code [unique]
  }
}

Table attribute_set_member {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  set_id uuid [not null]
  attribute_id uuid [not null]
  required boolean [not null]
  position integer [not null]
  indexes {
    (set_id, attribute_id) [unique]
  }
}

Table category_attribute_set {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  category_id uuid [not null]
  set_id uuid [not null]
  indexes {
    (category_id, set_id) [unique]
  }
}

Table product_attribute_set {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  product_id uuid [not null]
  set_id uuid [not null]
  indexes {
    (product_id, set_id) [unique]
  }
}

Table product_attribute_value {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  product_id uuid [not null]
  attribute_id uuid [not null]
  text_value text
  number_value numeric(24,8)
  boolean_value boolean
  date_value date
  indexes {
    (product_id, attribute_id) [unique]
  }
  Note: "Exactly one typed scalar populated, matching definition; selection types use product_attribute_selection instead."
}

Table product_attribute_value_translation {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  value_id uuid [not null]
  locale varchar(255) [not null]
  text_value text [not null]
  indexes {
    (value_id, locale) [unique]
  }
  Note: "Localized descriptive text only; numeric values never translated strings."
}

Table product_attribute_selection {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  product_id uuid [not null]
  attribute_id uuid [not null]
  option_id uuid [not null]
  indexes {
    (product_id, attribute_id, option_id) [unique]
  }
  Note: "Composite validation option belongs to attribute; single-select permits exactly one selection."
}

Table product_variant_axis {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  product_id uuid [not null]
  attribute_id uuid [not null]
  position integer [not null]
  indexes {
    (product_id, attribute_id) [unique]
  }
  Note: "Only single-select variant-eligible definitions."
}

Table product_variant_allowed_option {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  axis_id uuid [not null]
  option_id uuid [not null]
  indexes {
    (axis_id, option_id) [unique]
  }
  Note: "Option belongs to axis attribute."
}

Table variant {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  product_id uuid [not null]
  sku varchar(255) [not null]
  barcode varchar(255)
  combination_key varchar(255) [not null]
  price numeric(20,6) [not null]
  sale_price numeric(20,6)
  cost_price numeric(20,6)
  status varchar(255) [not null]
  version bigint [not null]
  indexes {
    sku [unique]
    (product_id, combination_key) [unique]
  }
  Note: "SKU immutable via CSV; sale_price 0 <= sale_price < price; costs private; simple variant key empty."
}

Table variant_option {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  variant_id uuid [not null]
  axis_id uuid [not null]
  option_id uuid [not null]
  indexes {
    (variant_id, axis_id) [unique]
  }
  Note: "Axis belongs to variant product; option is allowed for axis; every active axis exactly once."
}

Table variant_image {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  variant_id uuid [not null]
  asset_id uuid [not null]
  position integer [not null]
  indexes {
    (variant_id, asset_id) [unique]
  }
}

Table inventory_balance {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  variant_id uuid [not null]
  on_hand integer [not null]
  reserved integer [not null]
  committed integer [not null]
  threshold_override integer
  version bigint [not null]
  indexes {
    variant_id [unique]
  }
  Note: "All quantities nonnegative; reserved + committed <= on_hand; no warehouse ID in V1."
}

Table stock_reservation {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  order_item_id uuid [not null]
  quantity integer [not null]
  state varchar(255) [not null]
  expires_at timestamptz
  committed_at timestamptz
  departed_at timestamptz
  indexes {
    order_item_id [unique]
  }
  Note: "state reserved/committed/departed/released; no partial fulfillment in V1."
}

Table stock_movement {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  variant_id uuid [not null]
  order_item_id uuid
  import_job_id uuid
  operation_key varchar(255) [not null]
  kind varchar(255) [not null]
  on_hand_delta integer [not null]
  reserved_delta integer [not null]
  committed_delta integer [not null]
  reason text [not null]
  actor_id uuid
  indexes {
    operation_key [unique]
  }
  Note: "Append-only; unique operation prevents retry deductions; balances changed in same transaction."
}

Table restock {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  order_id uuid [not null]
  actor_id uuid [not null]
  reason text [not null]
  operation_key varchar(255) [not null]
  indexes {
    operation_key [unique]
  }
}

Table restock_item {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  restock_id uuid [not null]
  order_item_id uuid [not null]
  quantity integer [not null]
  movement_id uuid [not null]
  indexes {
    (restock_id, order_item_id) [unique]
  }
  Note: "Cumulative restock <= physically departed quantity."
}

Table wishlist {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  customer_id uuid [not null]
  indexes {
    customer_id [unique]
  }
}

Table wishlist_item {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  wishlist_id uuid [not null]
  product_id uuid [not null]
  indexes {
    (wishlist_id, product_id) [unique]
  }
}

Table review {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  customer_id uuid [not null]
  product_id uuid [not null]
  order_item_id uuid [not null]
  rating integer [not null]
  body text [not null]
  status varchar(255) [not null]
  moderator_id uuid
  moderation_reason text
  indexes {
    (customer_id, product_id) [unique]
  }
  Note: "Rating 1..5; verified delivered/collected purchase; only approved reviews in aggregates."
}

Table shopping_session {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  token_hash varchar(255) [not null]
  started_at timestamptz [not null]
  last_seen_at timestamptz [not null]
  qualified_at timestamptz
  consent_state varchar(255) [not null]
  excluded_reason varchar(255)
  indexes {
    token_hash [unique]
  }
}

Table cart {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  customer_id uuid
  guest_token_hash varchar(255)
  currency varchar(255) [not null]
  version bigint [not null]
  coupon_id uuid
  session_id uuid
  expires_at timestamptz [not null]
  status varchar(255) [not null]
}

Table cart_bundle {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  cart_id uuid [not null]
  promotion_id uuid [not null]
  quantity integer [not null]
  configuration_snapshot jsonb [not null]
}

Table cart_item {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  cart_id uuid [not null]
  variant_id uuid [not null]
  quantity integer [not null]
  bundle_id uuid
  Note: "Unique cart/variant/bundle using nulls-not-distinct semantics; whole positive quantities."
}

Table checkout_quote {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  cart_id uuid [not null]
  cart_version bigint [not null]
  settings_revision bigint [not null]
  quote_hash varchar(255) [not null]
  currency varchar(255) [not null]
  expires_at timestamptz [not null]
  totals jsonb [not null]
  allocations jsonb [not null]
  selected_delivery jsonb [not null]
  calculation_version varchar(255) [not null]
  indexes {
    quote_hash [unique]
  }
}

Table order_status_definition {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  code varchar(255) [not null]
  internal_state varchar(255) [not null]
  label_translations jsonb [not null]
  enabled boolean [not null]
  position integer [not null]
  indexes {
    code [unique]
  }
  Note: "Labels/substatuses only; state transition graph remains server policy."
}

Table sales_order {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  number varchar(255) [not null]
  customer_id uuid
  session_id uuid
  reporting_identity_hash varchar(255) [not null]
  quote_id uuid [not null]
  status_id uuid [not null]
  currency varchar(255) [not null]
  currency_exponent integer [not null]
  gross_merchandise numeric(20,6) [not null]
  discount_total numeric(20,6) [not null]
  net_merchandise numeric(20,6) [not null]
  delivery_fee numeric(20,6) [not null]
  tax_total numeric(20,6) [not null]
  grand_total numeric(20,6) [not null]
  payment_method varchar(255) [not null]
  contact_snapshot jsonb [not null]
  business_snapshot jsonb [not null]
  delivery_snapshot jsonb [not null]
  locale varchar(255) [not null]
  policy_acceptance jsonb [not null]
  placed_at timestamptz [not null]
  accepted_at timestamptz
  cancelled_at timestamptz
  version bigint [not null]
  indexes {
    number [unique]
  }
  Note: "Money and identity snapshots immutable after placement; zero tax; lifecycle updates audited."
}

Table order_address_snapshot {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  order_id uuid [not null]
  kind varchar(255) [not null]
  payload jsonb [not null]
  indexes {
    (order_id, kind) [unique]
  }
  Note: "Billing/shipping addresses frozen; no mutable address FK."
}

Table order_item {
