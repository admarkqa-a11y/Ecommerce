  planned_changes jsonb [not null]
  indexes {
    (job_id, row_number) [unique]
  }
}

Table import_asset {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  job_id uuid [not null]
  source_url text [not null]
  staged_asset_id uuid
  status varchar(255) [not null]
  error_code varchar(255)
}

Table export_job {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  actor_id uuid [not null]
  kind varchar(255) [not null]
  status varchar(255) [not null]
  parameters jsonb [not null]
  asset_id uuid
  expires_at timestamptz [not null]
}

Table background_job {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  kind varchar(255) [not null]
  resource_id uuid
  status varchar(255) [not null]
  attempts integer [not null]
  dedupe_key varchar(255) [not null]
  failure_code varchar(255)
  last_attempt_at timestamptz
  indexes {
    dedupe_key [unique]
  }
  Note: "Allowlisted retry types; application job visibility, not arbitrary remote execution."
}

Table idempotency_record {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  audience varchar(255) [not null]
  principal_key varchar(255) [not null]
  operation varchar(255) [not null]
  key varchar(255) [not null]
  request_hash varchar(255) [not null]
  response_snapshot jsonb [not null]
  resource_id uuid
  expires_at timestamptz
  indexes {
    (audience, principal_key, operation, key) [unique]
  }
  Note: "Financial operation uniqueness also enforced on domain rows; redact response secrets."
}

Table product_translation {
  id uuid [pk, not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
