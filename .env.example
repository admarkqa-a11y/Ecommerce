# Local container environment. Generate fresh secrets per client.
COMPOSE_PROJECT_NAME=retail_local
ENVIRONMENT=development
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-before-any-shared-deployment
POSTGRES_DB=retail
POSTGRES_USER=retail
POSTGRES_PASSWORD=replace-with-a-unique-random-database-password
DATABASE_URL=postgresql://retail:replace-with-a-unique-random-database-password@db:5432/retail
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:3000,http://localhost:3001
API_ORIGIN=http://api:8000
STOREFRONT_PORT=8080
ADMIN_PORT=8081
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
INDEXABLE=false

